# Copy this file to .env and fill in your real values
# NEVER commit the actual .env file to Git

# Django
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-new-one
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# HuggingFace
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# PostgreSQL (Supabase)
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_supabase_password
POSTGRES_HOST=aws-1-ap-south-1.pooler.supabase.com
POSTGRES_PORT=6543

# Optional: for HTTPS deployments
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
